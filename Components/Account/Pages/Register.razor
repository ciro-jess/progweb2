@page "/Account/Register"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using OnlineShop.Data.Entities
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager
@inject ILogger<Register> Logger
@inject ApplicationDbContext Db

<PageTitle>Registrati</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h1>Registrati</h1>
        <hr />

        @if (errorMessages.Any())
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var msg in errorMessages)
                {
                    <p class="mb-0">@msg</p>
                }
            </div>
        }

        <EditForm EditContext="editContext" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            @if (step == 1)
            {
                <h3> Passaggio 1 - Dati Personali </h3>

            <div class="form-floating mb-3">
                <InputText id="nome-input" @bind-Value="Input.Nome" class="form-control" 
                    autocomplete="username" aria-required="true" />
                <label for="nome-input">Nome</label>
                <ValidationMessage For="() => Input.Nome" class="text-danger" />
            
            </div>

            <div class="form-floating mb-3">
                <InputText id="cognome-input" @bind-Value="Input.Cognome" class="form-control" 
                    autocomplete="username" aria-required="true" />
                <label for="cognome-input">Cognome</label>
                <ValidationMessage For="() => Input.Cognome" class="text-danger" />
            
            </div>

            <div>
                <InputText id="telefono-input" @bind-Value="Input.Telefono" class="form-control" aria-required="false" placeholder="Telefono" />
                <label for="telefono-input">Telefono</label>
                <ValidationMessage For="() => Input.Telefono" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText id="indirizzo-input" @bind-Value="Input.Indirizzo" class="form-control" autocomplete="road" aria-required="true" />
                <label for="indirizzo-input">Indirizzo</label>
                <ValidationMessage For="() => Input.Indirizzo" class="text-danger" />

            </div>



           

            }
            else if (step == 2)
            {
                 <h3>passaggio 2- Account </h3>
                <div class="form-floating mb-3">
                <InputText id="email-input" @bind-Value="Input.Email" class="form-control" 
                    autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="email-input">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText id="password-input" type="password" @bind-Value="Input.Password" class="form-control" 
                    autocomplete="new-password" aria-required="true" placeholder="password" />
                <label for="password-input">Password</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText id="confirmpassword-input" type="password" @bind-Value="Input.ConfirmPassword" class="form-control" 
                    autocomplete="new-password" aria-required="true" placeholder="conferma password" />
                <label for="confirmpassword-input">Conferma Password</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>


            }
            else if  (step == 3)
            {
                
                <h4>passo 3- conferma </h4>
                <p><strong>Email:</strong>@Input.Email</p>
                <p><strong>Nome:</strong>@Input.Nome @Input.Cognome</p>
            
            }


            <div class="d-flex justify-content-between mt-3">
                <button type="button" class="btn btn-secondary" @onclick="Previous" disabled="@(step==1)">Indietro</button>
                <button type="button" class="btn btn-primary" @onclick="() => NextOrValidate()"> @(step < maxStep ? "Avanti" : "Registrati")</button>
            </div>
            

            <div class="mt-3">
                <p>Hai già un account? <a href="Account/Login">Accedi</a></p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private int step =1;
    private int maxStep = 3;
    private List<string> errorMessages = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private EditContext? editContext ;

    private InputModel Input { get; set; } = new();



    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }


    protected override void OnInitialized()
    {
        editContext = new EditContext(Input);
    }
    
    private async Task NextOrValidate()
    {
        Logger.LogDebug("NextOrValidate clicked. Current step: {step}", step);
        Logger.LogDebug("Input.Nome: {nome}, Input.Cognome: {cognome}", Input.Nome, Input.Cognome);
        
        var ok = ValidateCurrentStep();
        Logger.LogDebug("Validation result for step {step}: {ok}", step, ok);
        
        Console.WriteLine($"Step: {step}, Validation OK: {ok}, Nome: '{Input.Nome}', Cognome: '{Input.Cognome}'");
        
        if (ok)
        {
            if (step < maxStep)
            {
                step++;
                Console.WriteLine($"Advanced to step: {step}");
                StateHasChanged();
            }
            else
            {
                await OnSubmit();
            }
        }
        else
        {
            Console.WriteLine($"Validation failed for step {step}");
        }
    }

    private void Previous()
    {
        if (step > 1)
        {
            step--;
            StateHasChanged();
        }
    }

    private bool ValidateCurrentStep()
    {
        if (editContext == null) return false;
        editContext.NotifyValidationStateChanged();
        var isValid = editContext.Validate();
        // step 1 = personal data, step 2 = account
        if (step == 1)
        {
            return !string.IsNullOrWhiteSpace(Input.Nome) && !string.IsNullOrWhiteSpace(Input.Cognome);
        }
        else if (step == 2)
        {
            return !string.IsNullOrWhiteSpace(Input.Email)
                && new EmailAddressAttribute().IsValid(Input.Email)
                && !string.IsNullOrWhiteSpace(Input.Password)
                && Input.Password.Length >= 6
                && Input.Password == Input.ConfirmPassword;
        }
        return isValid;
    }



    public async Task OnSubmit()
    {
        errorMessages.Clear();

        var user = new ApplicationUser
        {   
            Nome = Input.Nome,
            Cognome = Input.Cognome,
            UserName = Input.Email,
            Email = Input.Email,
            EmailConfirmed = true  
        };

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            foreach (var e in result.Errors)
            {
                errorMessages.Add(e.Description);
            }
            return;
        }



        Logger.LogInformation("Nuovo utente creato.");

        // Assegna il ruolo selezionato
        if (await RoleManager.RoleExistsAsync(Input.Role))
        {
            await UserManager.AddToRoleAsync(user, Input.Role);
        }

       

        // Recupera hash password da Identity (non salvare la password in chiaro)
        var hashed = user.PasswordHash;
        var utente = new Utente
        {
            Nome = Input.Nome,
            Cognome = Input.Cognome,
            Email = Input.Email,
            PasswordHash = hashed ?? string.Empty,
            Ruolo = Input.Role ?? "Cliente",
            DataRegistrazione = DateTime.Now,
            Telefono = Input.Telefono
        };

        try
        {
            Db.Utenti.Add(utente);
            await Db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Errore salvando utente dominio");
            errorMessages.Add("Errore salvataggio dati utente. Riprovare più tardi.");
            return;
        }

        NavigationManager.NavigateTo(ReturnUrl ?? "/catalogo", forceLoad: true);
    }

    private sealed class InputModel


    {
        [Required(ErrorMessage =" in nome è obligatorio.")]
        public String Nome {get; set; } ="";

        [Required(ErrorMessage = "il cognome è obligatorio.")]
        public string Cognome {get; set; } ="";

        public string? Telefono {get; set;} 

        public string Indirizzo {get; set;} ="";



        [Required(ErrorMessage = "L'email è obbligatoria.")]
        [EmailAddress(ErrorMessage = "L'email non è valida.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "La password è obbligatoria.")]
        [StringLength(100, ErrorMessage = "La {0} deve essere almeno {2} e massimo {1} caratteri.", 
            MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Conferma Password")]
        [Compare("Password", ErrorMessage = "Le password non corrispondono.")]
        public string ConfirmPassword { get; set; } = "";

        [Required(ErrorMessage = "Il ruolo è obbligatorio.")]
        public string Role { get; set; } = "Cliente";
    }
}